            "ID": "DOCUMENT",
            "collections": {
                "display": true,
                "displayForm": "<ul class=\"collections\"><li><a href=\"/collections/islamic/1\">Islamic Manuscripts</a></li><li><a href=\"/collections/linesofthought/1\">Lines of Thought</a></li><li><a href=\"/collections/treasures/1\">Treasures of the Library</a></li></ul>",
                "label": "Member of",
